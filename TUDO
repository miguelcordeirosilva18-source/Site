<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Kraken Hub — Official</title>
    <meta name="description" content="Kraken Hub - Scripts, comunidade e novidades.">
    <meta name="theme-color" content="#09090b">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        :root {
            --bg: #070709;
            --bg2: #0d0d12;
            --card: rgba(255,255,255,.045);
            --border: rgba(255,255,255,.09);
            --text: #fff;
            --muted: #9b9ba7;
            --primary: #7c3aed;
            --primary2: #a855f7;
            --success: #22c55e;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background:
                radial-gradient(circle at 20% 10%, rgba(124,58,237,.18), transparent 30%),
                radial-gradient(circle at 80% 30%, rgba(168,85,247,.12), transparent 30%),
                var(--bg);
            color: var(--text);
            min-height: 100vh;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* NAVBAR */

        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            padding: 16px 6%;
            background: rgba(7,7,9,.72);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
        }

        .nav-content {
            max-width: 1200px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: .5px;
        }

        .logo span {
            color: var(--primary2);
        }

        .nav-links {
            display: flex;
            gap: 28px;
            align-items: center;
        }

        .nav-links a {
            color: #c8c8d0;
            font-size: 14px;
            transition: .25s;
        }

        .nav-links a:hover {
            color: white;
        }

        .nav-btn {
            background: var(--primary);
            padding: 10px 17px;
            border-radius: 10px;
            color: white !important;
            font-weight: 700;
        }

        .menu {
            display: none;
            border: 0;
            background: transparent;
            color: white;
            font-size: 26px;
            cursor: pointer;
        }

        /* HERO */

        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 120px 20px 70px;
        }

        .hero-content {
            max-width: 850px;
        }

        .badge {
            display: inline-block;
            padding: 8px 14px;
            border: 1px solid rgba(168,85,247,.35);
            background: rgba(124,58,237,.1);
            border-radius: 999px;
            color: #d8b4fe;
            font-size: 13px;
            margin-bottom: 25px;
        }

        h1 {
            font-size: clamp(45px, 9vw, 86px);
            line-height: .95;
            font-weight: 950;
            letter-spacing: -4px;
            margin-bottom: 25px;
        }

        h1 span {
            background: linear-gradient(90deg, #fff, #a855f7);
            -webkit-background-clip: text;
            color: transparent;
        }

        .hero p {
            max-width: 650px;
            margin: auto;
            color: var(--muted);
            font-size: 18px;
            line-height: 1.7;
        }

        .hero-buttons {
            margin-top: 35px;
            display: flex;
            gap: 14px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 22px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,.05);
            color: white;
            font-weight: 700;
            cursor: pointer;
            transition: .25s;
        }

        .btn:hover {
            transform: translateY(-3px);
            border-color: rgba(168,85,247,.5);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary2));
            border: 0;
        }

        /* SECTIONS */

        section {
            padding: 90px 6%;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        .section-title {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-title h2 {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .section-title p {
            color: var(--muted);
        }

        /* CARDS */

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            padding: 28px;
            border-radius: 18px;
            transition: .3s;
        }

        .card:hover {
            transform: translateY(-7px);
            border-color: rgba(168,85,247,.35);
            background: rgba(255,255,255,.065);
        }

        .icon {
            width: 45px;
            height: 45px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: rgba(124,58,237,.16);
            margin-bottom: 18px;
            font-size: 21px;
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            color: var(--muted);
            line-height: 1.6;
            font-size: 14px;
        }

        /* SCRIPT */

        .script-box {
            background: #050506;
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
        }

        .script-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px 18px;
            border-bottom: 1px solid var(--border);
        }

        .dots {
            display: flex;
            gap: 6px;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #555;
        }

        pre {
            padding: 22px;
            overflow-x: auto;
            color: #ddd;
            line-height: 1.6;
            font-size: 13px;
        }

        .copy-btn {
            padding: 8px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: rgba(255,255,255,.05);
            color: white;
            cursor: pointer;
        }

        /* STATUS */

        .status {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-top: 16px;
            color: #bcbcc5;
            font-size: 14px;
        }

        .online {
            width: 9px;
            height: 9px;
            background: var(--success);
            border-radius: 50%;
            box-shadow: 0 0 12px var(--success);
        }

        /* FAQ */

        .faq {
            max-width: 750px;
            margin: auto;
        }

        details {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 13px;
            margin-bottom: 12px;
            padding: 18px 20px;
        }

        summary {
            cursor: pointer;
            font-weight: 700;
        }

        details p {
            color: var(--muted);
            margin-top: 14px;
            line-height: 1.6;
        }

        /* DISCORD */

        .discord {
            text-align: center;
            background:
                linear-gradient(135deg, rgba(124,58,237,.18), rgba(168,85,247,.05)),
                var(--card);
            border: 1px solid var(--border);
            border-radius: 24px;
            padding: 60px 25px;
        }

        .discord h2 {
            font-size: 40px;
            margin-bottom: 12px;
        }

        .discord p {
            color: var(--muted);
            margin-bottom: 25px;
        }

        /* FOOTER */

        footer {
            border-top: 1px solid var(--border);
            padding: 30px 6%;
            color: #777782;
            text-align: center;
            font-size: 13px;
        }

        /* ANIMATION */

        .reveal {
            opacity: 0;
            transform: translateY(25px);
            transition: .7s ease;
        }

        .reveal.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* MOBILE */

        @media (max-width: 800px) {
            .nav-links {
                position: absolute;
                top: 68px;
                left: 5%;
                right: 5%;
                padding: 18px;
                border-radius: 15px;
                background: rgba(13,13,18,.96);
                border: 1px solid var(--border);
                display: none;
                flex-direction: column;
            }

            .nav-links.active {
                display: flex;
            }

            .menu {
                display: block;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            section {
                padding: 70px 5%;
            }

            h1 {
                letter-spacing: -2px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
        <div class="nav-content">

            <a href="#inicio" class="logo">
                KRAKEN<span>HUB</span>
            </a>

            <button class="menu" onclick="toggleMenu()">☰</button>

            <div class="nav-links" id="navLinks">
                <a href="#inicio">Início</a>
                <a href="#recursos">Recursos</a>
                <a href="#script">Script</a>
                <a href="#faq">FAQ</a>
                <a href="#discord" class="nav-btn">Discord</a>
            </div>

        </div>
    </nav>

    <!-- HERO -->
    <main id="inicio" class="hero">

        <div class="hero-content">

            <div class="badge">
                ⚡ KRAKEN HUB • OFFICIAL
            </div>

            <h1>
                O seu próximo<br>
                <span>nível começa aqui.</span>
            </h1>

            <p>
                Um hub moderno para organizar seus projetos,
                scripts, atualizações e comunidade em um único lugar.
            </p>

            <div class="hero-buttons">
                <a href="#script" class="btn btn-primary">
                    🚀 Ver Script
                </a>

                <a href="#discord" class="btn">
                    💬 Entrar no Discord
                </a>
            </div>

            <div class="status">
                <span class="online"></span>
                Sistema online
            </div>

        </div>

    </main>

    <!-- RECURSOS -->
    <section id="recursos">

        <div class="container">

            <div class="section-title reveal">
                <h2>Recursos</h2>
                <p>Tudo organizado em uma interface simples.</p>
            </div>

            <div class="cards">

                <div class="card reveal">
                    <div class="icon">⚡</div>
                    <h3>Rápido</h3>
                    <p>
                        Interface otimizada e leve para funcionar
                        bem em dispositivos móveis e computadores.
                    </p>
                </div>

                <div class="card reveal">
                    <div class="icon">🛠️</div>
                    <h3>Atualizações</h3>
                    <p>
                        Mantenha seus projetos organizados e
                        atualize os conteúdos sempre que necessário.
                    </p>
                </div>

                <div class="card reveal">
                    <div class="icon">🔒</div>
                    <h3>Organizado</h3>
                    <p>
                        Informações, links e recursos reunidos
                        em uma página fácil de navegar.
                    </p>
                </div>

            </div>

        </div>

    </section>

    <!-- SCRIPT -->
    <section id="script">

        <div class="container">

            <div class="section-title reveal">
                <h2>Script</h2>
                <p>Copie o código rapidamente.</p>
            </div>

            <div class="script-box reveal">

                <div class="script-top">

                    <div class="dots">
                        <span class="dot"></span>
                        <span class="dot"></span>
                        <span class="dot"></span>
                    </div>

                    <button class="copy-btn" onclick="copyScript()">
                        Copiar
                    </button>

                </div>

                <pre id="scriptCode"><code>loadstring(game:HttpGet("https://example.com/script.lua"))()</code></pre>

            </div>

        </div>

    </section>

    <!-- FAQ -->
    <section id="faq">

        <div class="container">

            <div class="section-title reveal">
                <h2>Perguntas frequentes</h2>
                <p>Algumas respostas rápidas.</p>
            </div>

            <div class="faq">

                <details class="reveal">
                    <summary>O site funciona no celular?</summary>
                    <p>
                        Sim. O layout é responsivo e foi preparado
                        para telas pequenas e grandes.
                    </p>
                </details>

                <details class="reveal">
                    <summary>Como atualizar o script?</summary>
                    <p>
                        Basta alterar o código ou link mostrado
                        na seção de script e publicar novamente.
                    </p>
                </details>

                <details class="reveal">
                    <summary>Onde encontro novidades?</summary>
                    <p>
                        Entre na comunidade do Discord para receber
                        atualizações e informações do projeto.
                    </p>
                </details>

            </div>

        </div>

    </section>

    <!-- DISCORD -->
    <section id="discord">

        <div class="container">

            <div class="discord reveal">

                <h2>Entre na comunidade</h2>

                <p>
                    Participe do Discord e acompanhe as novidades
                    do projeto.
                </p>

                <!-- TROQUE O LINK ABAIXO PELO SEU DISCORD -->
                <a
                    href="https://discord.gg/SEU-LINK"
                    target="_blank"
                    class="btn btn-primary"
                >
                    💬 Entrar no Discord
                </a>

            </div>

        </div>

    </section>

    <!-- FOOTER -->
    <footer>
        © <span id="year"></span> Kraken Hub.
        Todos os direitos reservados.
    </footer>

    <script>

        /* MENU MOBILE */

        function toggleMenu() {
            document
                .getElementById("navLinks")
                .classList.toggle("active");
        }

        /* COPIAR SCRIPT */

        function copyScript() {

            const code =
                document.getElementById("scriptCode").innerText;

            navigator.clipboard.writeText(code)
                .then(() => {

                    const button =
                        document.querySelector(".copy-btn");

                    button.innerText = "Copiado!";

                    setTimeout(() => {
                        button.innerText = "Copiar";
                    }, 1800);

                })
                .catch(() => {
                    alert("Não foi possível copiar.");
                });
        }

        /* ANIMAÇÕES */

        const observer =
            new IntersectionObserver((entries) => {

                entries.forEach(entry => {

                    if (entry.isIntersecting) {
                        entry.target.classList.add("show");
                    }

                });

            }, {
                threshold: 0.12
            });

        document
            .querySelectorAll(".reveal")
            .forEach(element => observer.observe(element));

        /* ANO */

        document.getElementById("year").textContent =
            new Date().getFullYear();

    </script>

</body>
</html>
